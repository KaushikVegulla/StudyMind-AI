# StudyMind AI - copy to .env, fill only what you are using
# Backend
CORS_ORIGINS=http://localhost:5173
# Supabase (needed when pgvector persistence is switched on)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
DATABASE_URL=
# LLM (pick one provider; leave empty to run in extractive scaffold mode)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
# Frontend
VITE_API_URL=http://localhost:8000
