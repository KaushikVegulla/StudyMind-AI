# StudyMind AI - copy to .env, fill only what you are using
# Backend
CORS_ORIGINS=http://localhost:5173
# Persistence: set DATABASE_URL to your Supabase Postgres connection string
# (Project Settings -> Database -> Connection string, URI form) to use
# Postgres + pgvector. Leave it empty to run on the in-memory backend.
DATABASE_URL=
# LLM (pick one provider; leave empty to run in extractive scaffold mode)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# LLM quota armour (defaults shown; retries with backoff, then a
# per-provider cooldown, then the next provider / extractive mode)
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BASE_SECONDS=0.5
LLM_COOLDOWN_THRESHOLD=3
LLM_COOLDOWN_SECONDS=60
# Embeddings runtime: fastembed (ONNX) is tried first, then
# sentence-transformers. Set to fastembed / sentence-transformers to
# force one, or none to disable embeddings (keyword retrieval only).
EMBEDDINGS_BACKEND=
# Parent-child retrieval: children are searched, parents give the
# prompt context. Set to off to search parent chunks directly.
PARENT_CHILD_RETRIEVAL=on
# Flashcard scheduling engine: fsrs (default) or sm2
SRS_ENGINE=fsrs
# Uploads: maximum PDF size in MB (413 above this)
MAX_UPLOAD_MB=25
# Rate limit for chat/generate endpoints, per IP per minute (0 = off)
RATE_LIMIT_PER_MINUTE=60
# Frontend
VITE_API_URL=http://localhost:8000
